rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == "nuryads701@gmail.com";
    }
    match /mercy_orders/{poId} {
      // Siapa pun yang membuka dashboard dapat melihat data MERCY.
      allow read: if true;
      // Hanya akun Google admin yang boleh membuat, mengubah, atau menghapus PO.
      allow create, update, delete: if isAdmin();
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
